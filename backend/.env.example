# Copy to backend/.env. All variables use the SMS_ prefix. Nothing here is required.
# SMS_TSHARK_PATH=/usr/bin/tshark        # default: discovered on PATH
# SMS_DATA_DIR=./data                    # uploads, SQLite DB, logs
# SMS_MAX_UPLOAD_MB=50
# SMS_ANALYSIS_TIMEOUT_S=120
# SMS_MAX_PACKETS=2000000
# SMS_RETENTION_DAYS=30
# SMS_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Optional AI explanations (default: none -> deterministic built-in text only).
# SMS_AI_PROVIDER=none                   # none | ollama | openai_compatible
# SMS_AI_ENDPOINT=http://localhost:11434
# SMS_AI_MODEL=llama3.1
# SMS_AI_API_KEY=                        # only for openai_compatible; never commit a real key
